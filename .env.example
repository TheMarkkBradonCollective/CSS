# Neon Postgres (create a Neon project named "CSS")
# Use the pooled connection string from the Neon dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/CSS?sslmode=require

# Local API (apps/api via wrangler dev)
# Set in apps/api/.dev.vars for wrangler — do not commit secrets.
# DATABASE_URL=postgresql://...

# Frontend → Worker API base URL
VITE_API_URL=http://localhost:8787

# Production example (set in Cloudflare Pages project settings)
# VITE_API_URL=https://css-api.<your-subdomain>.workers.dev
