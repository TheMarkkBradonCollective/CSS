# Neon Postgres (create a Neon project named "CSS")
# Use the pooled connection string from the Neon dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/CSS?sslmode=require

# Local API (apps/api via wrangler dev)
# Set in apps/api/.dev.vars for wrangler — do not commit secrets.
# DATABASE_URL=postgresql://...

# Auth: sessions are stored in Postgres (migrations/002_auth.sql).
# Passwords are hashed in the Worker (WebCrypto PBKDF2). No JWT_SECRET needed.

# Frontend → Worker API base URL
VITE_API_URL=http://localhost:8787

# Production builds use apps/web/.env.production (do not point those at localhost).
# VITE_API_URL=https://css-api.themarkkbrandoncollective-2d9.workers.dev
